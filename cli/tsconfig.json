{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM"],
    "strict": true,
    "skipLibCheck": true,
    "noUnusedLocals": true,
    "noEmit": true,
    "types": ["node"],
    "baseUrl": "..",
    "paths": { "@shared/*": ["src/shared/*"] }
  },
  "include": ["src", "../src/shared", "../src/renderer/src/lib/scripts.ts"]
}
