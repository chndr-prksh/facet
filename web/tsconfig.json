{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noUnusedLocals": true,
    "noEmit": true,
    "types": ["vite/client"],
    "baseUrl": "..",
    "paths": {
      "@shared/*": ["src/shared/*"],
      "@ui": ["src/renderer/src/components/ui.tsx"],
      "@styles/*": ["src/renderer/src/styles/*"]
    }
  },
  "include": ["src", "../src/shared", "../src/renderer/src/components/ui.tsx"]
}
